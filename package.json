{
	"name": "fitness-tracker",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && pnpm build:scripts",
		"preview": "vite preview",
		"start": "node server.js",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"db:start": "docker compose up -d",
		"db:stop": "docker compose down",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"user:create": "tsx --env-file=.env scripts/create-user.ts",
		"seed:dev": "tsx --env-file=.env scripts/seed-dev.ts",
		"build:scripts": "esbuild scripts/bootstrap.ts scripts/create-user.ts --bundle --platform=node --target=node24 --format=esm --outdir=build --log-level=warning",
		"deploy": "docker compose -f compose.prod.yaml up -d --build",
		"deploy:logs": "docker compose -f compose.prod.yaml logs -f app",
		"deploy:stop": "docker compose -f compose.prod.yaml down"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource/instrument-serif": "^5.3.0",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"better-auth": "^1.7.3",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"esbuild": "^0.28.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"jsdom": "^30.0.1",
		"postgres": "^3.4.9",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.23.13",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^5.0.0"
	},
	"packageManager": "pnpm@12.3.4"
}
