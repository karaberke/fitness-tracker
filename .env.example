# Copy to `.env` and fill in the values. `.env` is git-ignored.
# Read by the pnpm scripts, by `docker compose` (development database) and by
# `docker compose -f compose.prod.yaml` (full deployment).

# --- PostgreSQL ---
# Applied the first time the Docker volume is created; changing them later does
# not change the database. The password is embedded in a URL: stick to letters,
# digits and - _ . (or percent-encode anything else).
POSTGRES_USER=root
POSTGRES_PASSWORD=change-me
POSTGRES_DB=local
# Host port for the database, bound to 127.0.0.1 only.
POSTGRES_PORT=5432

# --- App (pnpm dev / pnpm start) ---
# Must match the POSTGRES_* values above. The Docker deployment builds its own URL.
DATABASE_URL="postgres://root:change-me@localhost:5432/local"

# --- Better Auth ---
# Random secret used to sign session cookies. Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-long-random-string"

# --- Deployment (docker compose -f compose.prod.yaml up -d --build) ---
# Port the app is published on: http://<lan-ip>:APP_PORT and http://<tailscale-name>:APP_PORT
APP_PORT=3000
# First administrator, created on the first start. Later starts never change the
# password, so feel free to change it in Settings afterwards.
ADMIN_EMAIL=you@example.com
ADMIN_NAME="Your Name"
ADMIN_PASSWORD=change-me-too
# Time zone used when the server formats dates.
# TZ=Europe/Istanbul

# --- Optional ---
# Pin a single public URL (only when the app sits behind an internet-facing
# reverse proxy). Leave unset for LAN + Tailscale access, where the app follows
# whatever address the browser used.
# ORIGIN=https://fitness.example.com
